# Client install settings. `bootstrap.sh` copies this to `.env` (mode 600) and fills
# the secrets. Never commit a real `.env`; keep it in the private per client store.

# Who and which release
CLIENT_ID=acme
SSD_VERSION=0.1.0
SSD_REGISTRY=ghcr.io/adiyab25

# Where the install is reached. SITE_ADDRESS is what Caddy serves (a bare host gets
# automatic HTTPS, `:80` sits behind the client's own TLS). PUBLIC_URL is the full
# browser facing URL the api uses (auth base URL and trusted origins, from feature 6).
SITE_ADDRESS=erp.example.com
PUBLIC_URL=https://erp.example.com

# Database (the passwords are generated by bootstrap.sh)
# POSTGRES_PASSWORD is the owner role; only postgres and migrate receive it. Migrations
# create a role and a schema owned by it, so the owner must be a superuser (the Compose
# postgres user is) or, on a managed database, hold CREATEROLE and be a member of
# ssdashboard_app.
POSTGRES_PASSWORD=__GENERATED__
# The application role's password: the api and worker log in with it. An install whose
# .env predates this setting adds it by hand (any long random value, for example
# `od -An -N32 -tx1 /dev/urandom | tr -d ' \n'`); the next migrate sets the login.
APP_DB_PASSWORD=__GENERATED__

# Auth secret, used from feature 6 (staff sign in). Rotating it signs every user out.
BETTER_AUTH_SECRET=__GENERATED__

# When the worker reconciles the stock ledger (cron, in the install's timezone setting).
LEDGER_RECONCILE_CRON=0 2 * * *

# When the worker deletes expired sessions, tokens and sign in counters (cron, same timezone).
AUTH_CLEANUP_CRON=0 3 * * *

# Comma separated extension packages baked into a derived image (empty for the core).
EXTENSIONS=

# Email (spec 0005). Leave MAIL_DRIVER as none to send no email at all: an admin then hands over
# temporary passwords, and the forgot password page tells people to ask an administrator.
# Use smtp or postmark to let people reset their own password by email.
MAIL_DRIVER=none
# The sender, like: ERP <no-reply@client.com>. Required unless MAIL_DRIVER is none.
MAIL_FROM=
# smtp: SMTP_HOST is required. SMTP_USER and SMTP_PASSWORD go together or both stay empty.
# SMTP_SECURITY is starttls (default), tls, or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# postmark: the server token. The sender must be verified in Postmark before the first send.
POSTMARK_SERVER_TOKEN=
