{
  "name": "@ssdashboard/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:scale": "vitest run --config ./vitest.config.scale.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@ssdashboard/config": "workspace:*",
    "@ssdashboard/contracts": "workspace:*",
    "@ssdashboard/db": "workspace:*",
    "@ssdashboard/i18n": "workspace:*",
    "better-auth": "^1.7.15",
    "nodemailer": "^10.3.1",
    "pg-boss": "^12.38.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "catalog:",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
