{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "MIGRATION_DATABASE_URL",
        "APP_DB_PASSWORD",
        "LEDGER_RECONCILE_CRON",
        "AUTH_CLEANUP_CRON",
        "PORT",
        "API_INTERNAL_URL",
        "PUBLIC_URL",
        "BETTER_AUTH_SECRET",
        "MAIL_DRIVER",
        "MAIL_FROM",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURITY",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "POSTMARK_SERVER_TOKEN",
        "EXTENSIONS",
        "APP_VERSION",
        "CLIENT_DISPLAY_NAME"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
