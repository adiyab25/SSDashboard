{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "MIGRATION_DATABASE_URL",
        "APP_DB_PASSWORD",
        "LEDGER_RECONCILE_CRON",
        "PORT",
        "API_INTERNAL_URL",
        "EXTENSIONS",
        "APP_VERSION",
        "CLIENT_DISPLAY_NAME"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
