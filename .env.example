# Local development. Copy to `.env` (git ignored); the api reads it on startup.
# The database matches deploy/compose.dev.yaml.
# The api and worker connect as the application role, which cannot edit the stock ledger.
DATABASE_URL=postgres://ssdashboard_app:ssdashboard_app@localhost:5433/ssdashboard
# `pnpm db:migrate` connects as the owner role and gives the application role this password.
MIGRATION_DATABASE_URL=postgres://ssdashboard:ssdashboard@localhost:5433/ssdashboard
APP_DB_PASSWORD=ssdashboard_app
# Read by `migrate` only. Both are stored on a database's first run and checked on every run after it
# (a different value stops migrate, changing nothing). TENANT_ID unset: one is generated.
# APP_DB_ROLE names the application role (never a superuser); it must match the
# user in DATABASE_URL.
# TENANT_ID=
# APP_DB_ROLE=ssdashboard_app

# The worker's nightly ledger reconciliation (optional, default 2am in the timezone setting).
# LEDGER_RECONCILE_CRON=0 2 * * *
# The worker's nightly cleanup of expired sign in rows (optional, default 3am).
# AUTH_CLEANUP_CRON=0 3 * * *

# The signed license file (spec 0009), read by the api and the worker at start and by the daily
# check. `pnpm bootstrap` writes a development license signed with the committed dev key (trusted
# only when NODE_ENV is not production and APP_VERSION is 0.0.0-dev) to .env.license.json and sets this to its path. Empty: no license
# file, so only licenses uploaded on the settings screen count.
LICENSE_FILE=
# When the worker checks the license each day (optional, default 00:20 in the timezone setting).
# LICENSE_CHECK_CRON=20 0 * * *
PORT=3001

# The install's name in the back office header (optional, default SSDashboard).
# CLIENT_DISPLAY_NAME=SSDashboard

# The web dev server forwards /api/* here (defaults to http://localhost:3001).
API_INTERNAL_URL=http://localhost:3001

# The address people open in the browser. It sets the sign in cookie's Secure flag, the trusted
# origin for writes, and the links in emails (no path, no trailing slash).
PUBLIC_URL=http://localhost:3000
# Optional. The path prefix of the staff pages when they share a host with the portal: every
# sign in cookie gets this Path and email links put it after PUBLIC_URL. Starts with /, no
# trailing /, no empty or dot segments. Empty (the default) means the whole host (Path=/).
# Changing it on a live install means revoking every session and clearing the site's cookies
# (docs/runbooks/staff-sign-in.md, section 9.3): an old cookie on the wider path shadows the new one.
# STAFF_BASE_PATH=
# Optional. The public portal's address. Every /api/auth/* request for that host answers 404,
# so sign in happens on the staff host only. Must be a different host name from PUBLIC_URL (a
# different port is not enough: cookies ignore the port).
# PORTAL_ORIGIN=

# Signs sessions (at least 32 characters). Generate one: openssl rand -base64 32
# Rotating it signs everyone out and makes enrolled two factor secrets unreadable.
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me

# Email (spec 0005): `none` (the api default) sends nothing, and an admin hands over temporary passwords.
# `smtp` or `postmark` turns on password reset by email; the worker sends through a queue.
# Local development catches every email in Mailpit (deploy/compose.dev.yaml); read them at
# http://localhost:8025.
MAIL_DRIVER=smtp
# The sender, like: ERP <no-reply@client.com>. Required unless MAIL_DRIVER is none.
MAIL_FROM=SSDashboard <no-reply@localhost>
# smtp: SMTP_HOST is required. SMTP_USER and SMTP_PASSWORD go together or both stay empty.
# SMTP_SECURITY is starttls (api default), tls, or none. Mailpit takes plain SMTP on 1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
# postmark: the server token. The sender must be verified in Postmark before the first send.
POSTMARK_SERVER_TOKEN=

# Object storage: Garage, an S3 compatible store (ADR 0002), from deploy/compose.dev.yaml.
# The api does not read these yet (they are not in apps/api/src/config/env.ts); they are here so
# the first feature that stores files finds a working bucket. `pnpm bootstrap` creates the bucket
# and fills the two keys below; leave them empty.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=ssdashboard-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Garage serves buckets by path (endpoint/bucket/key), not by subdomain.
S3_FORCE_PATH_STYLE=true
